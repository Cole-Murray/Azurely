# Entra ID app registration for the target tenant (see SETUP.md for how to
# obtain these). AZURE_TENANT_ID and AZURE_CLIENT_ID are not secret, but
# they're kept out of source control to avoid hardcoding tenant-specific
# values in git and to keep the door open for per-environment values later.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Client secret: set exactly one of the two below.
#
# Option A - plain env var (default, no Azure setup required):
AZURE_CLIENT_SECRET=
#
# Option B - Key Vault (production target - see CLAUDE.md's Secrets
# section and SECURITY.md §8). Set this instead of AZURE_CLIENT_SECRET
# above and leave AZURE_CLIENT_SECRET blank; main() fetches the
# "azure-client-secret" secret from this vault at startup using
# DefaultAzureCredential, which for local dev means `az login` first.
# AZURE_KEY_VAULT_URL=https://<vault-name>.vault.azure.net/

# Optional second tenant (the app registration is multi-tenant, so it
# reuses AZURE_CLIENT_ID/AZURE_CLIENT_SECRET above - no separate client
# secret needed). Leave both blank to run single-tenant as before; if you
# set one, you must set the other.
AZURE_TENANT_ID_2=
AZURE_TENANT_DISPLAYNAME_2=

# V3 (Azure RBAC / PIM tools) needs NO new env vars - the same
# AZURE_TENANT_ID/AZURE_CLIENT_ID/AZURE_CLIENT_SECRET above are reused for
# Azure Resource Manager calls (see CLAUDE.md's V3 architecture section for
# why the credential is audience-neutral). What V3 *does* need, outside this
# file entirely, is a one-time Azure RBAC grant per tenant: assign the app's
# service principal the built-in Reader role at that tenant's root
# management group. See SECURITY.md for the full permission checklist and
# grant status.

# ---------------------------------------------------------------------------
# Hosting (remote/Streamable HTTP transport - Azure Container Apps)
# ---------------------------------------------------------------------------
# Everything below is new for HTTP hosting. Leaving MCP_TRANSPORT unset (or
# set to "stdio") keeps local/Claude Desktop behavior EXACTLY as it was
# before any of this section existed - nothing here is read unless
# MCP_TRANSPORT=http.

# "stdio" (default) or "http". Set to "http" only when actually running this
# server as a hosted Container Apps replica.
# MCP_TRANSPORT=stdio

# Port to bind. Azure Container Apps sets this itself to tell the container
# which port it will probe; 8080 is only the local-dev default (also the
# Dockerfile's own EXPOSE/ENV PORT default, so the two agree).
# PORT=8080

# Interface to bind. MUST be 0.0.0.0 in a container - Container Apps' startup
# probe connects from outside the container's network namespace, and the
# 127.0.0.1 (loopback-only) local-dev default can never be reached from
# there. This is the single most common first-deploy failure for this kind
# of app.
# MCP_HTTP_HOST=127.0.0.1

# Path the MCP endpoint is served from. Deliberately path-bearing ("/mcp"),
# not "/" - Claude Code normalizes a pathless resource URL by appending a
# trailing slash, and that mismatch breaks Entra's OAuth `resource` parameter
# matching during token validation (surfaces as AADSTS9010010).
# MCP_HTTP_PATH=/mcp

# Comma-separated list of hostnames the transport will accept Host headers
# from (enables its built-in DNS-rebinding protection). Only meaningful once
# actually deployed behind a known hostname - leave unset otherwise.
# MCP_ALLOWED_HOSTS=

# Bounded retry count for the Key Vault credential warm-up performed after
# the HTTP socket is already bound (see src/http/httpServer.ts). Bounded so a
# persistently unreachable Key Vault gives up loudly (leaving /readyz
# reporting "failed", not crash-looping the process) instead of retrying
# forever.
# MCP_KEYVAULT_MAX_ATTEMPTS=5

# Inbound caller-token verification (validates the bearer token an MCP
# client presents to THIS server - the opposite direction from
# AZURE_TENANT_ID/AZURE_CLIENT_ID/AZURE_CLIENT_SECRET above, which is this
# server's own outbound identity when calling Graph/ARM). Required for a real
# deployment; if left unset, HTTP mode runs UNAUTHENTICATED, which is only
# valid for local/dev smoke testing (see src/http/httpServer.ts's
# startHttpServer for the exact fallback behavior).
#
# Entra tenant ID that issues (and whose JWKS validates) inbound caller tokens.
# MCP_INBOUND_TENANT_ID=
#
# Comma-separated accepted `aud` values for inbound tokens - a v2 Entra
# access token's `aud` is the API's own app (client) ID GUID, not a resource
# URI, so this should include at minimum that bare GUID and its
# `api://<guid>` form.
# MCP_INBOUND_AUDIENCES=
#
# Scope an inbound token must carry to be accepted. Defaults to "iam.read".
# MCP_REQUIRED_SCOPE=iam.read
#
# The deployed, public URL of the MCP endpoint (e.g.
# https://<app>.<region>.azurecontainerapps.io/mcp) - surfaced as `resource`
# in the RFC 9728 protected-resource metadata document and used to build
# requireBearerAuth's resourceMetadataUrl. Strongly recommended once
# deployed: omitting it means the well-known metadata document falls back to
# a best-effort URL derived from the inbound request's own Host header.
# MCP_CANONICAL_RESOURCE=
